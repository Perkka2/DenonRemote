@* The pre-HEOS receiver's own setup tree, read live.

   Its pages arrive rendered, with the current state and every allowed value in
   them, and in words rather than codes - so unlike the newer generation nothing
   has to be translated. Reading only: the page's form is where the receiver
   applies a change, and what it does with a partial post is not established. *@

@inject ILogger<AspSetupBrowser> Log

<section class="panel tight">
    <h2>Receiver setup</h2>
    <p class="muted-text">
        Read from the receiver's own setup pages, in its own words. A change is sent
        as the whole form, exactly as the receiver's own page sends it, then read
        back — so a setting it declines says so rather than appearing to have worked.
    </p>

    @if (groups.Count == 0)
    {
        <p class="muted-text">@(reading ? "Reading the receiver's menus…" : "This receiver didn't list any settings.")</p>
    }

    @foreach (var menu in groups.Select(g => g.Section).Distinct())
    {
        <h3 class="section-name">@menu</h3>
        <div class="grid">
            @foreach (var group in groups.Where(g => g.Section == menu))
            {
                var current = group;
                <button class="tile @(open == current ? "active" : "")" @onclick="() => ToggleAsync(current)">
                    @current.Label
                </button>
            }
        </div>
    }
</section>

@if (open is not null)
{
    <section class="panel">
        <div class="quick-head">
            <h2>@(screen?.Title is { Length: > 0 } title ? title : open.Label)</h2>
            <span class="now">@open.Section</span>
        </div>

        @if (loading)
        {
            <p class="muted-text">Reading…</p>
        }
        else if (screen is null)
        {
            <p class="muted-text">This receiver didn't serve that page.</p>
        }
        else
        {
            @if (screen.Help.Length > 0)
            {
                <p class="muted-text">@screen.Help</p>
            }
            @if (screen.LockedBy is { } why)
            {
                <p class="muted-text">Nothing here can change while @why.</p>
            }
            @if (Elsewhere)
            {
                @* The EQ tab drives the same bands with a proper set of sliders and
                   reads them back; a second, worse copy of it here would only be a
                   way to disagree with itself. *@
                <p class="muted-text">The band controls are on the <strong>EQ</strong> tab.</p>
            }

            @if (!string.IsNullOrEmpty(message))
            {
                <p class="muted-text">@message</p>
            }

            @if (screen.Rows.Count == 0)
            {
                <p class="muted-text">Nothing on this page to show.</p>
            }
            else if (Columns.Count > 1)
            {
                <div class="matrix">
                    <div class="matrix-row head">
                        <span class="matrix-name"></span>
                        @foreach (var column in Columns)
                        {
                            <span class="matrix-cell">@column</span>
                        }
                    </div>
                    @foreach (var index in Indexes)
                    {
                        <div class="matrix-row">
                            <span class="matrix-name">@index</span>
                            @foreach (var column in Columns)
                            {
                                    var cell = Cell(index, column);
                                <span class="matrix-cell">
                                    @if (cell is not null && cell.Editable && !Elsewhere)
                                    {
                                        <select class="text" value="@cell.Value" @key="(reads, index, column)"
                                                @onchange="args => WriteAsync(cell, args)">
                                            @foreach (var choice in cell.Options)
                                            {
                                                <option value="@choice.Code" selected="@(choice.Code == cell.Value)">@choice.Text</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="fact-value">@Display(cell)</span>
                                    }
                                </span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @foreach (var row in screen.Rows)
                {
                    var current = row;
                    <div class="setting wide">
                        <span>@current.Label</span>
                        @if (current.Editable && !Elsewhere)
                        {
                            <select class="text" value="@current.Value" @key="(reads, current.Name)"
                                    @onchange="args => WriteAsync(current, args)">
                                @foreach (var choice in current.Options)
                                {
                                    <option value="@choice.Code" selected="@(choice.Code == current.Value)">@choice.Text</option>
                                }
                            </select>
                        }
                        else if (current.NeedsArming && !current.Locked && !Elsewhere)
                        {
                            @* A number the receiver only takes when its Set is pressed:
                               the page works that way, so this does too. *@
                            <span class="valued">
                                <input class="text narrow" value="@current.Value" @key="(reads, current.Name)"
                                       @onchange="args => Typed(current, args)" />
                                <button class="pill" @onclick="() => SetAsync(current)">Set</button>
                            </span>
                        }
                        else
                        {
                            <span class="fact-value">@Display(current)</span>
                            @if (current.Locked && current.HasOptions)
                            {
                                <span class="hint">locked</span>
                            }
                        }
                    </div>
                }
            }
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public AspSetupClient Setup { get; set; } = default!;
    [Parameter, EditorRequired] public string Host { get; set; } = "";

    private IReadOnlyList<AspGroup> groups = [];
    private AspGroup? open;
    private AspPage? screen;
    private bool loading;
    private bool reading = true;
    private string? content;
    private string message = "";
    private int reads;
    private readonly Dictionary<string, string> typed = [];

    private void Typed(ConfigRow row, ChangeEventArgs args) =>
        typed[row.PostName] = args.Value?.ToString() ?? "";

    /// <summary>
    /// The menus come from the receiver, so they are read once when the tab opens
    /// rather than listed in the app - see AspCatalog for why that matters.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            groups = await Setup.ReadMenusAsync(Host, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogDebug("Reading the setup menus failed: {Message}", ex.Message);
        }
        finally
        {
            reading = false;
        }
    }

    private IReadOnlyList<string> Indexes => screen is null ? []
        : screen.Rows.Where(r => r.Index is not null).Select(r => r.Index!).Distinct().ToList();

    private IReadOnlyList<string> Columns
    {
        get
        {
            if (screen is null) return [];
            var indexed = screen.Rows.Where(r => r.Index is not null).ToList();
            var names = indexed.Select(r => r.Name).Distinct().ToList();
            return names.Count > 1 && Indexes.Count > 1 ? names : [];
        }
    }

    /// <summary>Screens the app already does better elsewhere, shown but not edited here.</summary>
    private bool Elsewhere =>
        open?.Label.Contains("Graphic EQ", StringComparison.OrdinalIgnoreCase) == true;

    private ConfigRow? Cell(string index, string name) =>
        screen?.Rows.FirstOrDefault(r => r.Index == index && r.Name == name);

    /// <summary>
    /// The receiver answers in its own short codes - HD1, LAT - but publishes the
    /// word for each beside it, so the word is always available here.
    /// </summary>
    private static string Display(ConfigRow? row)
    {
        if (row is null || row.Value.Length == 0) return "—";
        return row.Options.FirstOrDefault(o => o.Code == row.Value)?.Text ?? row.Value;
    }

    /// <summary>
    /// Sends one change and reads the page back. The receiver is the authority on
    /// whether it took: a setting it quietly declines comes back unchanged, and
    /// saying so beats pretending.
    /// </summary>
    private async Task WriteAsync(ConfigRow row, ChangeEventArgs args)
    {
        if (content is null) return;

        var value = args.Value?.ToString();
        if (string.IsNullOrEmpty(value)) return;

        var wanted = row.Options.FirstOrDefault(o => o.Code == value)?.Text ?? value;
        var what = row.Index is null ? row.Label : $"{row.Name} for {row.Index}";

        screen = await Setup.WriteAsync(Host, content, row.PostName, value, CancellationToken.None);
        // A refused setting comes back as it was, and Blazor will not redraw a select
        // whose bound value it thinks unchanged - so make them new elements.
        reads++;

        var after = screen?.Rows.FirstOrDefault(r => r.Name == row.Name && r.Index == row.Index);
        message = screen is null ? $"{what} — the receiver didn't answer."
            : after?.Value == value ? $"{what} set to {wanted}."
            : $"{what} didn't change — the receiver still reports {Display(after)}.";
    }

    /// <summary>
    /// Applies a typed value the way the page's Set button does: the number, and the
    /// hidden flag beside it turned on. Without the flag the receiver takes the post
    /// and ignores the number.
    /// </summary>
    private async Task SetAsync(ConfigRow row)
    {
        if (content is null || row.Arm is null) return;

        var value = typed.TryGetValue(row.PostName, out var entered) ? entered : row.Value;

        screen = await Setup.WriteAsync(Host, content,
            [new(row.PostName, value), new(row.Arm, "on")], CancellationToken.None);
        reads++;

        var after = screen?.Rows.FirstOrDefault(r => r.Name == row.Name && r.Index == row.Index);
        message = screen is null ? $"{row.Label} — the receiver didn't answer."
            : after?.Value == value ? $"{row.Label} set to {value}."
            : $"{row.Label} didn't change — the receiver still reports {Display(after)}.";
    }

    private async Task ToggleAsync(AspGroup group)
    {
        if (open == group) { open = null; screen = null; message = ""; return; }

        open = group;
        screen = null;
        message = "";
        typed.Clear();
        loading = true;
        try
        {
            // The menu links to a frameset; the controls are in a frame inside it.
            content = await Setup.ContentFrameAsync(Host, group.Path, CancellationToken.None);
            if (content is not null)
                screen = await Setup.ReadAsync(Host, content, CancellationToken.None);
            reads++;
        }
        catch (Exception ex)
        {
            Log.LogDebug("Setup page {Path} failed: {Message}", group.Path, ex.Message);
        }
        finally
        {
            loading = false;
        }
    }
}
