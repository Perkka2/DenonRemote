@* A labelled row of mutually exclusive small buttons. *@

<div class="option-row">
    <span class="option-label">@Label</span>
    <div class="option-buttons">
        @foreach (var option in Options)
        {
            <button class="pill @(IsActive(option.Code) ? "active" : "")"
                    disabled="@Disabled"
                    @onclick="() => Selected.InvokeAsync(option.Code)">
                @option.Label
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public OptionValue[] Options { get; set; } = [];
    [Parameter] public string? Current { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> Selected { get; set; }

    private bool IsActive(string code) =>
        string.Equals(Current, code, StringComparison.OrdinalIgnoreCase);
}
