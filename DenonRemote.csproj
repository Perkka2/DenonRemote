<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DenonRemote</RootNamespace>

    <!-- Local builds report this. A release is stamped with its tag by the workflow,
         so this only has to be roughly right between releases. -->
    <Version>1.4.0</Version>
    <Product>Denon Remote</Product>
    <AssemblyName>DenonRemote</AssemblyName>

    <!-- Publishing is self-contained and single-file (both on the publish command).
         The runtime's native libraries are linked into the executable rather than
         extracted at startup - extracting them is what produced an access violation
         inside a socket P/Invoke on macOS, so IncludeNativeLibrariesForSelfExtract
         stays off. Trimming stays off too: Blazor leans on reflection. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Everything is formatted with InvariantCulture, so ICU isn't needed. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
