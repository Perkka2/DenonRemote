<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DenonRemote</RootNamespace>

    <Version>1.0.2</Version>
    <Product>Denon Remote</Product>
    <AssemblyName>DenonRemote</AssemblyName>

    <!-- Publishing is self-contained but NOT single-file. Bundling the native
         libraries means extracting them at startup, and on macOS that produced an
         access violation inside a socket P/Invoke. A folder of files is boring and
         works. Trimming stays off too: Blazor leans on reflection. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Everything is formatted with InvariantCulture, so ICU isn't needed. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
